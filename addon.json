{
  "contract": 1,
  "id": "fmdv",
  "tool": "fmdv_addon",
  "name": "Foot-and-mouth disease virus",
  "version": "0.1.0",
  "consumer": "vsnp_gui",
  "description": "FMDV for vsnp_gui: each sample's reference is the closest of NanoFMDV's 79 lineage genomes (VP1 vote), primers clipped from ONT amplicon reads, a consensus and VP1 typing per sample against GenBank, VP1 trees with GenBank context, and reports for the outbreak team. From FMDV mode (kapurlab/vsnp_gui#14).",
  "env": "fmdv_addon",
  "sample_naming": "folder",
  "requires": {
    "binaries": [
      "minimap2",
      "samtools",
      "seqkit",
      "blastn",
      "makeblastdb",
      "mafft"
    ],
    "modules": [
      "Bio",
      "openpyxl"
    ]
  },
  "library": {
    "markers": [
      "LIBRARY_VERSION",
      "lineages.json",
      "panels/vp1.fasta",
      "reference_options",
      "scopes.json"
    ],
    "reference_options": "reference_options",
    "vcf_db_folders": "vcf_db_folders"
  },
  "scopes": {
    "file": "scopes.json",
    "label": "Scope",
    "default": "FMDV"
  },
  "hooks": {
    "choose_reference": "hooks/choose_reference.py",
    "prepare_reads": "hooks/prepare_reads.py",
    "after_sample": "hooks/after_sample.py",
    "after_run": "hooks/after_run.py"
  },
  "actions": [
    {
      "id": "vp1_tree",
      "label": "Build VP1 tree",
      "description": "One serotype's samples with the lineage panel and GenBank context (mafft + RAxML); rewrites the reports.",
      "command": "actions/vp1_tree.py",
      "params": [
        {
          "name": "serotype",
          "label": "Serotype",
          "choices_from": "metric:serotype",
          "fixture": "SAT1"
        }
      ]
    },
    {
      "id": "retype",
      "label": "Type VP1 again",
      "description": "blastn typing of every sample's VP1 consensus, then the reports.",
      "command": "actions/retype.py",
      "params": []
    }
  ],
  "qc_thresholds": {
    "genome_coverage": {
      "pass_min": 90.0,
      "review_min": 70.0
    },
    "coverage": {
      "pass_min": 100.0,
      "review_min": 20.0
    },
    "mapping_rate": {
      "pass_min": 20.0,
      "review_min": null
    },
    "contamination_review": true
  },
  "columns": [
    {
      "key": "serotype",
      "label": "Serotype"
    },
    {
      "key": "lineage",
      "label": "Lineage"
    },
    {
      "key": "topotype",
      "label": "Topotype (VP1)"
    },
    {
      "key": "vp1_lineage",
      "label": "VP1 lineage"
    },
    {
      "key": "vp1_identity",
      "label": "VP1 identity",
      "unit": "%"
    },
    {
      "key": "identity",
      "label": "Read identity"
    },
    {
      "key": "genome_called",
      "label": "Genome called",
      "unit": "%"
    },
    {
      "key": "vp1_called",
      "label": "VP1 called",
      "unit": "%"
    },
    {
      "key": "vp1_nearest",
      "label": "Nearest VP1 record"
    }
  ],
  "reports": {
    "sample": "{sample}_FMDV_report.html",
    "run": "FMDV_run_report.html"
  }
}
